{
  "name": "coverly-shelf",
  "description": "Box art and screenshots for 3DS game pages, as a purely cosmetic browser extension.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:libretro": "bun scripts/gen-libretro-map.ts",
    "e2e": "bun scripts/e2e.ts",
    "e2e:options": "bun scripts/e2e-options.ts",
    "e2e:lists": "bun scripts/e2e-lists.ts",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  }
}
